        </mxCell>
        <mxCell id="wegF1v21Y2GM_95cMq---26" parent="U3OZUrBjCpXaWpCMO_cn-0" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#1A1A2E;fontSize=13;fontStyle=1;" value="&lt;b&gt;Local&lt;/b&gt;" vertex="1">
          <mxGeometry height="16.867469879518072" width="409.8039215686275" x="33.52941176470589" y="570.1204819277109" as="geometry" />
        </mxCell>
        <mxCell id="wegF1v21Y2GM_95cMq---27" parent="U3OZUrBjCpXaWpCMO_cn-0" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#6B7F8A;fontSize=11;" value="Solo locales de la Galeria de Zarzal, Valle del Cauca." vertex="1">
